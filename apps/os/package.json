{
  "name": "@atlas/os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter \"@atlas/os^...\" build && node scripts/write-build-info.cjs && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --pool=forks",
    "verify:build-info": "node scripts/verify-build-info.cjs"
  },
  "dependencies": {
    "@atlas/client": "workspace:*",
    "@atlas/registry": "workspace:*",
    "@atlas/shared": "workspace:*",
    "@supabase/supabase-js": "^2.110.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
