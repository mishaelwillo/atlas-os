{
  "name": "atlas-web-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "control:verify": "pnpm --filter @atlas/control-schema verify",
    "control:status": "pnpm --filter @atlas/control-schema status",
    "control:handoff": "pnpm --filter @atlas/control-schema handoff",
    "control:archive-handoff": "pnpm --filter @atlas/control-schema archive-handoff"
  },
  "devDependencies": {
    "turbo": "^2.0.4",
    "typescript": "^5.4.5"
  }
}
